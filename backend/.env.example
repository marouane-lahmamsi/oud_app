# Database Configuration
DATABASE_URL='mysql+pymysql://username:password@host:3306/database_name'

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API Configuration
API_PREFIX=/api/v1

# File Upload (optional)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Order notifications (Hostinger Email)
# Keep SMTP_PASSWORD only in the GitHub BACKEND_ENV_FILE secret, never in Git.
ORDER_NOTIFICATION_ENABLED=true
ORDER_NOTIFICATION_RECIPIENTS=lahmamsimarouane@gmail.com,jaknitaha@gmail.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=contact@medinaoud.com
SMTP_PASSWORD=replace-with-the-contact-mailbox-password
SMTP_USE_SSL=true
SMTP_TIMEOUT=15
MAIL_FROM=contact@medinaoud.com
MAIL_FROM_NAME=Medina Oud
